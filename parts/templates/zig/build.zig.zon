.{
    .name = .zig_template,
    // Remove `-dev` when tagging a new release and add it back on the next development cycle.
    .version = "0.1.0-dev",
    // Must be kept in sync with `flake.lock` via the following command:
    // ```
    // nix flake update
    // ```
    .minimum_zig_version = "0.16.0",
    // Must be kept in sync with `nix/deps.nix` via the following command:
    // ```
    // zon2nix > nix/deps.nix
    // ```
    .dependencies = .{},
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "LICENSE",
    },
    //.fingerprint =
}
